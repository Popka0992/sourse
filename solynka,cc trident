SafeConnect(RunService.RenderStepped, function(delta)
    if not movement.enabled then return end
    
    local target_trident = (getgenv and getgenv().trident) or _G.trident or (shared and rawget(shared, "trident"))
    local middle = nil
    if target_trident and target_trident.middlepart then
        middle = target_trident.middlepart
    else
        local ignore = workspace:FindFirstChild("Ignore") or (workspace:FindFirstChild("Const") and workspace.Const:FindFirstChild("Ignore"))
        local localChar = ignore and ignore:FindFirstChild("LocalCharacter")
        middle = localChar and (localChar:FindFirstChild("Middle") or localChar:FindFirstChild("HumanoidRootPart"))
    end
    
    if not middle or not middle.Parent then return end
    
    local speed = movement.speed
    local bhop_enabled = movement.bhop_enabled
    local bhop_duration = movement.bhop_duration
    local bhop_height = movement.bhop_height
    local bhop_max_height = movement.bhop_max_height
    local forcesprint = movement.forcesprint

    local on_ground = false
    local ground_normal = Vector3.new(0, 1, 0)
    local distance_to_ground = 999
    
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.FilterDescendantsInstances = {Player.Character, workspace.CurrentCamera}
    raycastParams.IgnoreWater = true
    
    local ground_ray = workspace:Raycast(middle.Position, Vector3.new(0, -5, 0), raycastParams)
    if ground_ray then
        distance_to_ground = (middle.Position - ground_ray.Position).Magnitude
        ground_normal = ground_ray.Normal
        if distance_to_ground <= 3.6 then
            on_ground = true
        end
    end

    local cameralook = Camera.CFrame.LookVector
    cameralook = Vector3.new(cameralook.X, 0, cameralook.Z)
    local direction = Vector3.zero
    
    direction = UserInputService:IsKeyDown(Enum.KeyCode.W) and direction + cameralook or direction;
    direction = UserInputService:IsKeyDown(Enum.KeyCode.S) and direction - cameralook or direction;
    direction = UserInputService:IsKeyDown(Enum.KeyCode.D) and direction + Vector3.new(- cameralook.Z, 0, cameralook.X) or direction;
    direction = UserInputService:IsKeyDown(Enum.KeyCode.A) and direction + Vector3.new(cameralook.Z, 0, - cameralook.X) or direction;
    
    if direction ~= Vector3.zero then
        direction = direction.Unit
    end

    if direction ~= Vector3.zero then
        local wall_ray = workspace:Raycast(middle.Position, direction * 3.5, raycastParams)
        if wall_ray then
            local plane_normal = wall_ray.Normal
            direction = direction - (direction:Dot(plane_normal) * plane_normal)
            if direction ~= Vector3.zero then
                direction = direction.Unit
            end
        end
    end

    if bhop_enabled and UserInputService:IsKeyDown(Enum.KeyCode.C) and UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
        if on_ground and not is_jumping then
            start_y = middle.Position.Y
            is_jumping = true
            wtf = 0
            niga = speed
        end

        if is_jumping then
            wtf = wtf + delta
            
            if wtf >= bhop_duration or (wtf > 0.1 and on_ground) then
                is_jumping = false
                wtf = 0
            end
            
            niga = math.clamp(niga - delta * 6, 25, speed)
            local progress = math.clamp(wtf / bhop_duration, 0, 1)
            local vertical_velocity = math.cos(progress * math.pi) * bhop_height
            
            local current_height = middle.Position.Y
            local current_offset = current_height - start_y
            
            if current_offset >= bhop_max_height and vertical_velocity > 0 then
                vertical_velocity = -vertical_velocity * 0.5
            end
            
            middle.AssemblyLinearVelocity = Vector3.new(
                direction.X * niga,
                vertical_velocity,
                direction.Z * niga
            )
        else
            local pull_down = (distance_to_ground > 3.1) and -12 or middle.AssemblyLinearVelocity.Y
            middle.AssemblyLinearVelocity = Vector3.new(
                direction.X * speed,
                pull_down,
                direction.Z * speed
            )
        end
    else
        if forcesprint and middle then
            if on_ground then
                local horizontal_vel = direction * speed
                local slope_vel = horizontal_vel - (horizontal_vel:Dot(ground_normal) * ground_normal)
                
                middle.AssemblyLinearVelocity = Vector3.new(
                    slope_vel.X,
                    slope_vel.Y,
                    slope_vel.Z
                )
            else
                middle.AssemblyLinearVelocity = Vector3.new(
                    direction.X * speed,
                    middle.AssemblyLinearVelocity.Y,
                    direction.Z * speed
                )
            end
        end
        niga = speed
        wtf = 0
        is_jumping = false
    end
end)

local ESP_INTERVAL = 1 / 90 
local espLastTick = 0

SafeConnect(RunService.Heartbeat, function()
    local now = tick() 
    if now - espLastTick < ESP_INTERVAL then return end 
    espLastTick = now
    
    local camPos = Camera.CFrame.Position 
    local s = ESP.settings
    
    for m, d in next, ESP.cache.boxes do
        local function hide() 
            d.nameText.Visible = false 
            d.distText.Visible = false 
            d.weapText.Visible = false 
            d.combinedFrame.Visible = false
        end
        
        if not m or not m.Parent or not s.enabled or not d.hrp or not d.hrp.Parent then 
            hide() 
            updateChams(m, false) 
            continue 
        end
        
        local hrpPos = d.hrp.Position
        local distSq = (hrpPos.X - camPos.X)^2 + (hrpPos.Y - camPos.Y)^2 + (hrpPos.Z - camPos.Z)^2
        
        if distSq > s.renderDistance * s.renderDistance or shouldSkip(m) then 
            hide() 
            updateChams(m, false) 
            continue 
        end
        
        if now - d.lastCache > 0.25 then 
            d.isPlayer = ESP_IsPlayer(m) 
            d.isSleeper = ESP_IsSleeper(m) 
            d.cachedWeapon = detectWeapon(m)
            
            local currentArmor = {}
            local armorFolder = m:FindFirstChild("Armor")
            if armorFolder then
                for _, item in ipairs(armorFolder:GetChildren()) do
                    table.insert(currentArmor, item.Name)
                end
            end

            local armorChanged = #currentArmor ~= #d.lastArmorList
            if not armorChanged then
                for i = 1, #currentArmor do
                    if currentArmor[i] ~= d.lastArmorList[i] then
                        armorChanged = true
                        break
                    end
                end
            end
            
            if armorChanged then
                d.lastArmorList = currentArmor
                d.armorNeedsRebuild = true 
            end
            
            d.lastCache = now 
        end
        
        local topPos, topVis = Camera:WorldToViewportPoint(hrpPos + ESP.const.V3_UP)
        local bottomPos = Camera:WorldToViewportPoint(hrpPos - ESP.const.V3_DN)
        
        if not topVis then 
            hide() 
            updateChams(m, false) 
            continue 
        end
        
        local isWithinChamRange = distSq <= (s.chamsRenderDistance * s.chamsRenderDistance)
        updateChams(m, isWithinChamRange)
        
        local h = bottomPos.Y - topPos.Y 
        if h < 5 then hide() continue end
        
        local px, py, dist = topPos.X, topPos.Y + h * 0.5, math.floor(math.sqrt(distSq))
        local currentWeapon = d.cachedWeapon

        if s.weaponImageEnabled and currentWeapon ~= "None" then
            if d.lastWeapName ~= currentWeapon then
                d.lastWeapName = currentWeapon
                
                if d.activeVisual then
                    d.activeVisual:Destroy()
                    d.activeVisual = nil
                end
                
                local template = ESP.cache.images[currentWeapon]
                if template == nil then
                    local item = findItemInShared(currentWeapon)
                    if item then
                        local visual = prepareViewport(item)
                        if visual then
                            ESP.cache.images[currentWeapon] = visual
                            template = visual
                        end
                    end
                    if template == nil then
                        ESP.cache.images[currentWeapon] = false
                    end
                end
                
                if template then
                    local cell = Instance.new("Frame")
                    cell.Name = "00_Weapon"
                    cell.BackgroundTransparency = 1
                    cell.Size = UDim2.new(0, 32, 0, 32)
                    
                    local clonedVisual = template:Clone()
                    local cam = clonedVisual:FindFirstChildOfClass("Camera")
                    if cam then clonedVisual.CurrentCamera = cam end
                    clonedVisual.Parent = cell
                    
                    cell.Parent = d.combinedFrame
                    d.activeVisual = cell
                end
            end
        else
            if d.activeVisual then
                d.activeVisual:Destroy()
                d.activeVisual = nil
                d.lastWeapName = ""
            end
        end

        if s.armorImageEnabled then
            if d.armorNeedsRebuild then
                d.armorNeedsRebuild = false
                
                for _, av in ipairs(d.activeArmorVisuals) do
                    av:Destroy()
                end
                d.activeArmorVisuals = {}
                
                for i, armorName in ipairs(d.lastArmorList) do
                    local template = ESP.cache.images[armorName]
                    if template == nil then
                        local item = findItemInShared(armorName)
                        if item then
                            local visual = prepareViewport(item)
                            if visual then
                                ESP.cache.images[armorName] = visual
                                template = visual
                            end
                        end
                        if template == nil then
                            ESP.cache.images[armorName] = false
                        end
                    end
                    
                    if template then
                        local cell = Instance.new("Frame")
                        cell.Name = string.format("01_Armor_%02d", i)
