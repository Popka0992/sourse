    ["righthandle"] = true
}

local function IsBaseStructurePart(part)
    if not part:IsA("BasePart") then return false end
    local lowerName = string.lower(part.Name)
    
    if BaseNamesFilter[lowerName] then
        return true
    end
    
    local parent = part.Parent
    if parent and parent:IsA("Model") then
        local pName = string.lower(parent.Name)
        if BaseNamesFilter[pName] or parent:FindFirstChild("Hitbox") or parent:FindFirstChild("LeftWall") then
            if not string.find(lowerName, "enclosure") and not string.find(lowerName, "door") and not string.find(lowerName, "lock") then
                return true
            end
        end
    end
    return false
end

local function ApplyXrayToPart(part)
    if not IsBaseStructurePart(part) then return end
    
    if not XraySettings.Cache[part] then
        XraySettings.Cache[part] = {
            Transparency = part.Transparency,
            CastShadow = part.CastShadow
        }
    end
    
    part.Transparency = XraySettings.Transparency
    part.CastShadow = false
end

local function UpdateXrayState()
    if XraySettings.Enabled then
        for _, desc in ipairs(workspace:GetDescendants()) do
            if desc:IsA("BasePart") then
                ApplyXrayToPart(desc)
            end
        end
    else
        for part, original in pairs(XraySettings.Cache) do
            if part and part.Parent then
                pcall(function()
                    part.Transparency = original.Transparency
                    part.CastShadow = original.CastShadow
                end)
            end
        end
        table.clear(XraySettings.Cache)
    end
end

SafeConnect(workspace.DescendantAdded, function(desc)
    if XraySettings.Enabled and desc:IsA("BasePart") then
        task.wait(0.1) 
        pcall(ApplyXrayToPart, desc)
    end
end)

