                    Default = Color3.fromRGB(75, 115, 65),
                    Callback = function(v) ESP.settings.lootMilitaryColor = v end
                })

                local LootBackpackColOpt = LootSection:Toggle({
                    Name = "Color: Backpacks (Dropped)",
                    Flag = "LootBackpackColOpt",
                    Default = false,
                })
                LootBackpackColOpt:Colorpicker({
                    Name = "Backpack Color",
                    Flag = "LootBackpackCol",
                    Default = Color3.fromRGB(165, 113, 78),
                    Callback = function(v) ESP.settings.lootBackpackColor = v end
                })

                LootSection:Slider({
                    Name = "Loot Render Distance",
                    Flag = "LootRenderDist",
                    Min = 100,
                    Max = 5000,
                    Default = 1000,
                    Suffix = "m",
                    Decimals = 10,
                    Callback = function(Value)
                        ESP.settings.lootRenderDistance = Value
                    end
                })
            end
        end
    end

    do
        local MovementSubPage = MiscPage:SubPage({Name = "Movement", Columns = 2})
        local ExploitsSubPage = MiscPage:SubPage({Name = "World & Exploits", Columns = 2})

        do
            local MovementSection = MovementSubPage:Section({Name = "Movement & Speedhack", Side = 1}) do
                MovementSection:Toggle({
                    Name = "Enable Speedhack",
                    Flag = "MvEnabled",
                    Default = false,
                    Callback = function(Value)
                        movement.enabled = Value
                    end
                })

                MovementSection:Toggle({
                    Name = "Enable BunnyHop (C + Shift)",
                    Flag = "MvBhopEnabled",
                    Default = false,
                    Callback = function(Value)
                        movement.bhop_enabled = Value
                    end
                })

                MovementSection:Slider({
                    Name = "Speed Limit",
                    Flag = "MvSpeedLimit",
                    Min = 16,
                    Max = 120,
                    Default = 50,
                    Suffix = " studs/s",
                    Callback = function(Value)
                        movement.speed = Value
                    end
                })

                MovementSection:Slider({
                    Name = "Bhop Jump Height",
                    Flag = "MvBhopHeight",
                    Min = 5,
                    Max = 35,
                    Default = 10,
                    Suffix = " studs",
                    Callback = function(Value)
                        movement.bhop_height = Value
                    end
                })

                MovementSection:Slider({
                    Name = "Bhop Max Height Limit",
                    Flag = "MvBhopMaxHeight",
                    Min = 5,
                    Max = 50,
                    Default = 15,
                    Suffix = " studs",
                    Callback = function(Value)
                        movement.bhop_max_height = Value
                    end
                })

                MovementSection:Slider({
                    Name = "Bhop Jump Duration",
                    Flag = "MvBhopDuration",
                    Min = 0.1,
                    Max = 1.0,
                    Default = 0.3,
                    Decimals = 0.05,
                    Suffix = "s",
                    Callback = function(Value)
                        movement.bhop_duration = Value
                    end
                })

                MovementSection:Toggle({
                    Name = "Enable Force Sprint",
                    Flag = "MvForceSprint",
                    Default = false,
                    Callback = function(Value)
                        movement.forcesprint = Value
                    end
                })
            end
        end

        do
            local SkyboxSection = ExploitsSubPage:Section({Name = "Skybox Changer", Side = 1}) do
                SkyboxSection:Toggle({
                    Name = "Enable Skybox Changer",
                    Flag = "SkyboxEnabled",
                    Default = false,
                    Callback = function(Value)
                        SkyboxSettings.Enabled = Value
                        UpdateSkyboxState()
                    end
                })

                SkyboxSection:Dropdown({
                    Name = "Select Custom Skybox",
                    Flag = "SkyboxSelect",
                    Items = {"Night", "Nebula Space", "Rainy Sky", "Cosmic Stars", "Red Clouds"},
                    Default = "Night",
                    Multi = false,
                    Callback = function(Value)
                        SkyboxSettings.Selected = Value
                        if SkyboxSettings.Enabled then
                            UpdateSkyboxState()
                        end
                    end
                })
            end

            local EnvironmentSection = ExploitsSubPage:Section({Name = "World Changer", Side = 1}) do
                local EnvToggle = EnvironmentSection:Toggle({
                    Name = "Light Overrides",
                    Flag = "StealthEnvEnabled",
                    Default = false,
                    Callback = function(Value)
                        StealthLighting.Enabled = Value
                        UpdateStealthLighting()
                    end
                })
                
                EnvToggle:Colorpicker({
                    Name = "Custom Ambient Filter",
                    Flag = "StealthAmbientCol",
                    Default = Color3.fromRGB(255, 255, 255),
                    Callback = function(v)
                        StealthLighting.Ambient = v
                        if StealthLighting.Enabled then UpdateStealthLighting() end
                    end
                })

                EnvironmentSection:Slider({
                    Name = "Custom Brightness",
                    Flag = "StealthBrightnessVal",
                    Min = -0.5,
                    Max = 1.0,
                    Default = 0.0,
                    Decimals = 0.02,
                    Callback = function(Value)
                        StealthLighting.Brightness = Value
                        if StealthLighting.Enabled then UpdateStealthLighting() end
                    end
                })

                EnvironmentSection:Slider({
                    Name = "Custom Contrast",
                    Flag = "StealthContrastVal",
                    Min = -0.5,
                    Max = 1.0,
                    Default = 0.0,
                    Decimals = 0.02,
                    Callback = function(Value)
                        StealthLighting.Contrast = Value
                        if StealthLighting.Enabled then UpdateStealthLighting() end
                    end
                })

                EnvironmentSection:Slider({
                    Name = "Custom Saturation",
                    Flag = "StealthSaturationVal",
                    Min = -1.0,
                    Max = 2.0,
                    Default = 0.0,
                    Decimals = 0.05,
                    Callback = function(Value)
                        StealthLighting.Saturation = Value
                        if StealthLighting.Enabled then UpdateStealthLighting() end
                    end
                })
            end

            local FreecamXraySection = ExploitsSubPage:Section({Name = "Freecam & Base X-Ray", Side = 2}) do
                local FreecamToggleInstance
                FreecamToggleInstance = FreecamXraySection:Toggle({
                    Name = "Enable Freecam",
                    Flag = "FreecamEnabledToggle",
                    Default = false,
                    Callback = function(Value)
                        FreecamSettings.Enabled = Value
                        toggleFreecam()
                    end
                })
                
                FreecamToggleInstance:Keybind({
                    Default = Enum.KeyCode.F3,
                    Flag = "FreecamKeybind",
                    Mode = "Toggle",
                    Callback = function(Value)
                        if FreecamToggleInstance then
                            FreecamToggleInstance:Set(Value)
                        end
                    end
                })

                FreecamXraySection:Slider({
                    Name = "Fly Speed",
                    Flag = "FreecamSpeedSlider",
                    Min = 1,
                    Max = 15,
                    Default = 2,
                    Suffix = "x multiplier",
                    Decimals = 0.1,
                    Callback = function(Value)
                        FreecamSettings.Speed = Value
                    end
                })

                FreecamXraySection:Slider({
                    Name = "Mouse Sensitivity",
                    Flag = "FreecamSensitivitySlider",
                    Min = 0.1,
                    Max = 5.0,
                    Default = 1.0,
                    Decimals = 0.05,
                    Callback = function(Value)
                        FreecamSettings.Sensitivity = Value
                    end
                })

                FreecamXraySection:Slider({
                    Name = "Sprint Multiplier (Shift)",
                    Flag = "FreecamSprintSlider",
                    Min = 1.1,
                    Max = 5.0,
                    Default = 2.5,
                    Decimals = 0.1,
                    Callback = function(Value)
                        FreecamSettings.SprintMultiplier = Value
                    end
                })

                local XrayToggleInstance
                XrayToggleInstance = FreecamXraySection:Toggle({
                    Name = "Enable Base X-Ray",
                    Flag = "BaseXrayEnabled",
                    Default = false,
                    Callback = function(Value)
                        XraySettings.Enabled = Value
                        UpdateXrayState()
                    end
                })

                XrayToggleInstance:Keybind({
                    Default = Enum.KeyCode.V,
                    Flag = "XrayKeybind",
                    Mode = "Toggle",
                    Callback = function(Value)
                        if XrayToggleInstance then
                            XrayToggleInstance:Set(Value)
                        end
                    end
                })

                FreecamXraySection:Slider({
                    Name = "X-Ray Transparency",
                    Flag = "XrayTransparencySlider",
                    Min = 0,
                    Max = 1,
                    Default = 0.75,
                    Decimals = 0.05,
                    Callback = function(Value)
                        XraySettings.Transparency = Value
                        if XraySettings.Enabled then
                            UpdateXrayState()
                        end
                    end
                })
            end
        end
    end

    do
        local Playerlist = PlayersPage:Playerlist({
            Callback = function(...)
                local Args = { ... }
                table.foreach(Args, print)
            end
        })
    end
end

Library:Notification("Solyanka.cc", "Loaded successfully! Executed in " .. string.format("%.4f", os.clock() - LoadTick) .. " seconds.", 5)

if getgenv then
    pcall(function()
        getgenv().Library = Library
    end)
end

return Library
