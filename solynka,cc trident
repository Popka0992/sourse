local function AB_GetVelocityPart(model)
    if not model then return nil end
    return model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head") or model:FindFirstChild("Torso")
end

local function AB_GetTargetPart(model)
    if not model then return nil end
    local targetName = AimbotSettings.TargetPart
    
    if targetName == "Torso" then
        return model:FindFirstChild("Torso") or model:FindFirstChild("UpperTorso") or model:FindFirstChild("LowerTorso") or model:FindFirstChild("HumanoidRootPart")
    end
    
    return model:FindFirstChild(targetName) or model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart")
end

local function AB_IsVisible(targetPart)
    if not AimbotSettings.WallCheck then return true end
    local origin = Camera.CFrame.Position
    local destination = targetPart.Position
    local direction = destination - origin
    
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {Player.Character, targetPart.Parent}
    params.IgnoreWater = true
    
    local result = workspace:Raycast(origin, direction, params)
    return result == nil
end

local function AB_GetTargetVelocity(model, deltaTime)
    if not model then return Vector3.new() end
    local part = AB_GetVelocityPart(model)
    if not part then return Vector3.new() end
    
    if part.AssemblyLinearVelocity and part.AssemblyLinearVelocity.Magnitude > 0.1 then
        return part.AssemblyLinearVelocity
    end

    local currentTick = tick()
    local lastData = AimbotCache.lastPos[model]
    
    if not lastData then
        AimbotCache.lastPos[model] = { pos = part.Position, time = currentTick }
        AimbotCache.smoothVel[model] = Vector3.new()
        return Vector3.new()
    end
    
    local elapsed = math.clamp(currentTick - lastData.time, 0.001, 0.05)
    local rawVelocity = (part.Position - lastData.pos) / elapsed
    AimbotCache.lastPos[model] = { pos = part.Position, time = currentTick }
    
    local previousVelocity = AimbotCache.smoothVel[model] or Vector3.new()
    local smoothedVelocity = previousVelocity:Lerp(rawVelocity, math.clamp(deltaTime * 10, 0, 1))
    AimbotCache.smoothVel[model] = smoothedVelocity
    return smoothedVelocity
end

