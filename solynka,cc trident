local function getOreTypeAndPart(model)
    if not model or model.Name ~= "Model" then return nil end
    
    local parts = {}
    for _, child in ipairs(model:GetChildren()) do
        if child:IsA("MeshPart") and string.find(child.MeshId, "12939036056") then
            table.insert(parts, child)
        end
    end
    
    if #parts == 0 then return nil end
    
    local stonePart = nil
    local ironPart = nil
    local nitratePart = nil
    
    for _, part in ipairs(parts) do
        local colorName = part.BrickColor.Name
        local r, g, b = part.Color.R * 255, part.Color.G * 255, part.Color.B * 255
        
        if colorName == "Burlap" or (r > 160 and r < 220 and g > 140 and g < 190 and b > 90 and b < 140) then
            ironPart = part
        elseif colorName == "Institutional white" or (r > 230 and g > 230 and b > 230) then
            nitratePart = part
        elseif colorName == "Dark taupe" or (r > 50 and r < 90 and g > 50 and g < 90 and b > 50 and b < 90) then
            stonePart = part
        end
    end
    
    if ironPart then
        return "Iron", ironPart
    elseif nitratePart then
        return "Nitrate", nitratePart
    elseif stonePart then
        return "Stone", stonePart
    end
    
    return nil
end

local function getLootTypeAndPart(model)
    if not model then return nil end
    local modelName = model.Name

    if modelName == "Model" or string.find(modelName, "BACKPACK") then
        local fabricPart = nil
        local metalPart = nil
        
        for _, child in ipairs(model:GetChildren()) do
            if child:IsA("BasePart") then
                if child.Material == Enum.Material.Fabric and child.Name == "Part" then
                    fabricPart = child
                elseif child.Material == Enum.Material.Metal and child.Name == "Part" then
                    metalPart = child
                end
            end
        end
        
        if fabricPart and metalPart then
            local fs = fabricPart.Size
            local ms = metalPart.Size
            if math.abs(fs.X - 2.0) < 0.6 and math.abs(fs.Y - 2.0) < 0.6 and math.abs(ms.X - 0.2) < 0.15 then
                return "Backpack", fabricPart
            end
        end

        if string.find(modelName, "BACKPACK") then
            local prim = model:FindFirstChild("Part") or model:FindFirstChildOfClass("BasePart")
            if prim then
                return "Backpack", prim
            end
        end
    end

    if modelName ~= "Model" then return nil end
    
    local safeBody = model:FindFirstChild("Body")
    if safeBody and model:FindFirstChild("Dials") and model:FindFirstChild("Wheel") then
        return "Safe", safeBody
    end
    
    local machinePart = model:FindFirstChild("Machine")
    if machinePart and model:FindFirstChild("Dispenser") then
        return "Vending Machine", machinePart
    end
    
    local boxPart = model:FindFirstChild("box")
    if boxPart and model:FindFirstChild("trash") then
        return "Cardboard Box", boxPart
    end
    
    local mBottom = model:FindFirstChild("Bottom")
    if mBottom and model:FindFirstChild("Handles") then
        return "Military Crate", mBottom
    end

    if safeBody and model:FindFirstChild("default") and not model:FindFirstChild("Dials") then
        if safeBody:IsA("MeshPart") and string.find(safeBody.MeshId, "13856404606") then
            return "Iron Crate", safeBody
        end
        return "Crate", safeBody
    end
    
    local defaultPart = model:FindFirstChild("default")
    if defaultPart and defaultPart:IsA("MeshPart") then
        if string.find(defaultPart.MeshId, "18507721359") then
            return "Scrap Barrel", defaultPart
        end
        if #defaultPart:GetChildren() > 3 then
            return "Oil Gasoline", defaultPart
        end
    end
    
    local pPart = model:FindFirstChild("Prim")
    if pPart and pPart:IsA("BasePart") then
        local size = pPart.Size
        local aspectDiff = math.abs(size.X - size.Z)
        
        if aspectDiff > 0.4 then
            return "Gasoline", pPart
        else
            return "Oil Gasoline", pPart
        end
    end
    
    return nil
end

