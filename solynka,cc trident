    local screenCenter = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)

    if currentTarget and currentTarget.Parent then
        local targetPart = AB_GetTargetPart(currentTarget)
        if targetPart then
            local screenPos, visible = Camera:WorldToViewportPoint(targetPart.Position)
            if visible then
                local distanceToCenter = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                if distanceToCenter > config.FovRadius * 2 then 
                    currentTarget = nil 
                end
            else 
                currentTarget = nil 
            end
        else 
            currentTarget = nil 
        end
    else 
        currentTarget = nil 
    end
    
    if not currentTarget then
        local nearestDistance = math.huge
        local nearestCenterDist = math.huge
        
        for _, otherPlayer in ipairs(AimbotCache.players) do
            if not otherPlayer or not otherPlayer.Parent then continue end
            if otherPlayer == Player.Character or isLocalModel(otherPlayer) then continue end
            if config.SleepCheck and ESP_IsSleeper(otherPlayer) then continue end
            if config.AiCheck and ESP_IsAI(otherPlayer) then continue end
            if config.TeamCheck and ESP_IsTeam(otherPlayer) then continue end
            
            local targetPart = AB_GetTargetPart(otherPlayer)
            if not targetPart then continue end
            
            local worldDist = (cameraPosition - targetPart.Position).Magnitude
            if worldDist > config.AimRadius then continue end
            
            local screenPos, visible = Camera:WorldToViewportPoint(targetPart.Position)
            if not visible then continue end
            
            local distanceToCenter = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
            if distanceToCenter > config.FovRadius then continue end
            
            if not AB_IsVisible(targetPart) then continue end
            
            if worldDist < nearestDistance or (worldDist == nearestDistance and distanceToCenter < nearestCenterDist) then
                nearestDistance = worldDist
                nearestCenterDist = distanceToCenter
                currentTarget = otherPlayer
            end
        end
    end
    
    if not currentTarget then return end
    
    local targetPart = AB_GetTargetPart(currentTarget)
    if not targetPart or not isBindPressed(config.Keybind) then return end
    
    local targetDistance = (cameraPosition - targetPart.Position).Magnitude
    local targetVelocity = AB_GetTargetVelocity(currentTarget, deltaTime)
    local final3DTargetPos = targetPart.Position

    if config.PredictionEnabled and LocalWeaponStats.hasWeapon then
        local projectileSpeed = 280
        local timeToTarget = targetDistance / projectileSpeed

        local dropComp = (0.5 * 196.2 * (timeToTarget ^ 2)) * (LocalWeaponStats.up * 0.08) * config.PredictionScaleUp
        local leadComp = targetVelocity * timeToTarget * LocalWeaponStats.side

        final3DTargetPos = targetPart.Position + Vector3.new(0, dropComp, 0) + leadComp
    end

    local predictedScreenPos, visible = Camera:WorldToViewportPoint(final3DTargetPos)
    if not visible then return end

    local fovScale = Camera.FieldOfView / 70.0

    local rawMoveX = (predictedScreenPos.X - screenCenter.X)
    local rawMoveY = (predictedScreenPos.Y - screenCenter.Y)

    local moveX = (rawMoveX * fovScale) / config.Smoothness
    local moveY = (rawMoveY * fovScale) / config.Smoothness

    if mousemoverel then
        mousemoverel(moveX, moveY)
    end
end)

local HitboxCache = {
    Original = {},
    MixToken = 0
}

local function Hitbox_ShouldSkip(model)
    if not model or not model.Parent then return true end
    local settings = HitboxSettings
    if settings.AiCheck and ESP_IsAI(model) then return true end
    if settings.SleepCheck and ESP_IsSleeper(model) then return true end
    if settings.TeamCheck and ESP_IsTeam(model) then return true end
    return false
end

local function Hitbox_BackupPart(part)
    if not HitboxCache.Original[part] then
        HitboxCache.Original[part] = {
            Size = part.Size,
            Transparency = part.Transparency,
            Color = part.Color,
            Material = part.Material,
            CanCollide = part.CanCollide
        }
    end
end

local function Hitbox_RestorePart(part)
    if not part or not part.Parent then return end
    local backup = HitboxCache.Original[part]
    if not backup then return end
    part.Size = backup.Size
    part.Transparency = backup.Transparency
    part.Color = backup.Color
    part.Material = backup.Material
    part.CanCollide = backup.CanCollide
end

local function Hitbox_ApplyProperties(part)
    if not part or not part:IsA("BasePart") then return end
    Hitbox_BackupPart(part)
    local settings = HitboxSettings
    part.Size = Vector3.new(settings.SizeX, settings.SizeY, settings.SizeZ)
    part.Transparency = settings.Transparency
    part.Color = settings.Color
    part.CanCollide = settings.CanCollide 
end

local function Hitbox_RestoreAll()
    for part, backup in pairs(HitboxCache.Original) do
        if part and part.Parent then
            part.Size = backup.Size
            part.Transparency = backup.Transparency
            part.Color = backup.Color
            part.Material = backup.Material
            part.CanCollide = backup.CanCollide
        end
    end
    HitboxCache.Original = {}
end

local function Hitbox_ApplyToModel(model)
    if not model or not model.Parent then return end
    local settings = HitboxSettings
    local head = model:FindFirstChild("Head")
    local torso = model:FindFirstChild("Torso") or model:FindFirstChild("HumanoidRootPart")
    
    if not head or not torso then return end
    
    if Hitbox_ShouldSkip(model) or not settings.Enabled then
        Hitbox_RestorePart(head)
        Hitbox_RestorePart(torso)
        return
    end
    
    if settings.TargetPart == "Head" then
        Hitbox_ApplyProperties(head)
        Hitbox_RestorePart(torso)
    elseif settings.TargetPart == "Torso" then
        Hitbox_ApplyProperties(torso)
        Hitbox_RestorePart(head)
    end
end

local function Hitbox_UpdateAll()
    if HitboxSettings.TargetPart == "Mix" then return end
    for _, model in pairs(workspace:GetChildren()) do
        if model:IsA("Model") and model.Name ~= Player.Name then
            if model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart") then
                Hitbox_ApplyToModel(model)
            end
        end
    end
end

local function Hitbox_StartMixLoop()
    HitboxCache.MixToken = HitboxCache.MixToken + 1
    local localToken = HitboxCache.MixToken
    
    task.spawn(function()
        local activePhase = 0
        local settings = HitboxSettings
        
        while HitboxCache.MixToken == localToken and settings.Enabled and settings.TargetPart == "Mix" do
            for _, model in pairs(workspace:GetChildren()) do
                if model:IsA("Model") and model.Name ~= Player.Name then
                    local head = model:FindFirstChild("Head")
                    local torso = model:FindFirstChild("Torso") or model:FindFirstChild("HumanoidRootPart")
                    
                    if head and torso and not Hitbox_ShouldSkip(model) then
                        if activePhase == 0 then
                            Hitbox_ApplyProperties(head)
                            Hitbox_RestorePart(torso)
                        else
                            Hitbox_ApplyProperties(torso)
                            Hitbox_RestorePart(head)
                        end
                    end
                end
            end
            activePhase = 1 - activePhase
            task.wait(settings.MixSpeed)
        end
        
        for _, model in pairs(workspace:GetChildren()) do
            if model:IsA("Model") then
                local head = model:FindFirstChild("Head")
                local torso = model:FindFirstChild("Torso") or model:FindFirstChild("HumanoidRootPart")
                if head then Hitbox_RestorePart(head) end
                if torso then Hitbox_RestorePart(torso) end
            end
        end
    end)
end

