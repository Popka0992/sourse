        end
    end
end)

local function isBindPressed(bind)
    if not bind then return false end
    local rawBind = bind
    if type(bind) == "table" then
        rawBind = bind.Value or bind[1] or bind
    end
    
    if type(rawBind) == "table" then
        for _, val in pairs(rawBind) do
            if typeof(val) == "EnumItem" then
                rawBind = val
                break
            end
        end
    end
    
    if typeof(rawBind) == "EnumItem" then
        if rawBind.ClassName == "UserInputType" then
            return UserInputService:IsMouseButtonPressed(rawBind)
        elseif rawBind.ClassName == "KeyCode" then
            return UserInputService:IsKeyDown(rawBind)
        end
    end
    
    return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
end

