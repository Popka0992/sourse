end

local function UpdateStealthLighting()
    local effect = GetStealthCorrection()
    if not effect then return end
    
    if StealthLighting.Enabled then
        effect.Enabled = true
        effect.Brightness = StealthLighting.Brightness
        effect.Contrast = StealthLighting.Contrast
        effect.Saturation = StealthLighting.Saturation
        effect.TintColor = StealthLighting.Ambient
    else
        effect.Enabled = false
    end
end

