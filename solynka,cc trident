local function detectWeapon(model)
    if not model then return "None" end
    local isLocal = isLocalModel(model)
    local currentTime = tick() 
    
    if isLocal then
        return LocalWeaponStats.Name
    end
    
    local lastUpdate = ESP.cache.weaponTime[model] 
    if lastUpdate and currentTime - lastUpdate < 1.2 then 
        return ESP.cache.weapon[model] or "None" 
    end
    
    local hand = model:FindFirstChild("HandModel")
    if not hand then 
        ESP.cache.weapon[model] = "None" 
        ESP.cache.weaponTime[model] = currentTime 
        return "None" 
    end
    
    local bestMatchName = "None"
    local bestMatchCount = 0
    
    for weaponName, parts in pairs(PartSets) do
        local foundCount = 0
        for _, partPath in ipairs(parts) do
            local foundPart
            if string.find(partPath, "/") then
                foundPart = getSafePath(hand, partPath)
            else
                foundPart = hand:FindFirstChild(partPath, true)
            end
            
            if foundPart then
                foundCount = foundCount + 1
            end
        end
        
        if foundCount >= (#parts * 0.4) and foundCount > bestMatchCount then
            bestMatchName = weaponName
            bestMatchCount = foundCount
        end
    end
    
    ESP.cache.weapon[model] = bestMatchName 
    ESP.cache.weaponTime[model] = currentTime 
    return bestMatchName
end

local function updateLocalWeaponCache()
    local fpsArms = getSafePath(workspace, "Const/Ignore/FPSArms") or getSafePath(workspace, "Ignore/FPSArms")
    local hand = fpsArms and fpsArms:FindFirstChild("HandModel")
    
    if not hand then
        local localChar = getSafePath(workspace, "Const/Ignore/LocalCharacter") or Player.Character
        hand = localChar and localChar:FindFirstChild("HandModel")
    end
    
    if not hand then
        LocalWeaponStats.hasWeapon = false
        LocalWeaponStats.Name = "None"
        LocalWeaponStats.side = 0
        LocalWeaponStats.up = 0
        return
    end

    local bestWeapon = "None"
    local maxScore = 0

    for weaponName, parts in pairs(PartSets) do
        local score = 0
        local totalParts = 0
        for _, partPath in ipairs(parts) do
            if partPath ~= "DefaultSight" then
                totalParts = totalParts + 1
                local foundPart
                if string.find(partPath, "/") then
                    foundPart = getSafePath(hand, partPath)
                else
                    foundPart = hand:FindFirstChild(partPath, true)
                end
                if foundPart then
                    score = score + 1
                end
            end
        end

        local ratio = totalParts > 0 and (score / totalParts) or 0
        if ratio > maxScore and ratio >= 0.25 then
            maxScore = ratio
            bestWeapon = weaponName
        end
    end

    if bestWeapon ~= "None" then
        LocalWeaponStats.hasWeapon = true
        LocalWeaponStats.Name = bestWeapon
        local stats = WeaponPredictionStats[bestWeapon]
        if stats then
            LocalWeaponStats.side = stats.side
            LocalWeaponStats.up = stats.up
        else
            LocalWeaponStats.side = 0
            LocalWeaponStats.up = 0
        end
    else
        LocalWeaponStats.hasWeapon = false
        LocalWeaponStats.Name = "None"
        LocalWeaponStats.side = 0
        LocalWeaponStats.up = 0
    end
end

task.spawn(function()
    while shared.SolyankaSessionToken == CurrentSessionToken do
        pcall(updateLocalWeaponCache)
        task.wait(0.15)
    end
end)

local function getWeaponStats(weaponName)
    local lowerName = string.lower(weaponName)
    for name, stats in pairs(WeaponPredictionStats) do
        if string.lower(name) == lowerName then
            return stats
        end
    end
    return nil
end

local function findItemRecursively(parent, itemName)
    local lowerName = string.lower(itemName)
    local direct = parent:FindFirstChild(itemName)
    if direct then return direct end
    
    for _, child in ipairs(parent:GetChildren()) do
        if string.lower(child.Name) == lowerName then
            return child
        end
        if child:IsA("Folder") then
            local found = findItemRecursively(child, itemName)
            if found then return found end
        end
    end
    return nil
end

local function findItemInShared(itemName)
    local sharedFolder = ReplicatedStorage:FindFirstChild("Shared")
    local items = sharedFolder and sharedFolder:FindFirstChild("items")
    if not items then return nil end
    return findItemRecursively(items, itemName)
end

local function getBoundingBoxOfDescendants(object)
    local minX, minY, minZ = math.huge, math.huge, math.huge
    local maxX, maxY, maxZ = -math.huge, -math.huge, -math.huge
    local hasParts = false
    
    for _, p in ipairs(object:GetDescendants()) do
        if p:IsA("BasePart") then
            hasParts = true
            local pos = p.Position
            local size = p.Size
            minX = math.min(minX, pos.X - size.X/2)
            minY = math.min(minY, pos.Y - size.Y/2)
            minZ = math.min(minZ, pos.Z - size.Z/2)
            maxX = math.max(maxX, pos.X + size.X/2)
            maxY = math.max(maxY, pos.Y + size.Y/2)
            maxZ = math.max(maxZ, pos.Z + size.Z/2)
        end
    end
    
    if not hasParts and object:IsA("BasePart") then
        return object.CFrame, object.Size
    end
    
    if hasParts then
        local center = Vector3.new((minX + maxX)/2, (minY + maxY)/2, (minZ + maxZ)/2)
        local size = Vector3.new(maxX - minX, maxY - minY, maxZ - minZ)
        return CFrame.new(center), size
    end
    
    return CFrame.new(0, 0, 0), Vector3.new(1, 1, 1)
end

local function prepareViewport(item)
    local imageNode = item:FindFirstChild("Image")
    if not imageNode then return nil end
    
    local vp = Instance.new("ViewportFrame")
    vp.BackgroundTransparency = 1
    vp.Size = UDim2.new(1, 0, 1, 0)
    
    vp.Ambient = Color3.fromRGB(240, 240, 240)
    vp.LightColor = Color3.fromRGB(255, 255, 255)
    vp.LightDirection = Vector3.new(-1, -1, -1)
    
    local clone = imageNode:Clone()
    clone.Parent = vp
    
    local camera = Instance.new("Camera")
    camera.FieldOfView = 35
    camera.Parent = vp
    vp.CurrentCamera = camera
    
    local cf, size = getBoundingBoxOfDescendants(clone)
    local maxDim = math.max(size.X, size.Y, size.Z)
    if maxDim == 0 then maxDim = 1 end
    
    local dist = (maxDim / 2) / math.tan(math.rad(camera.FieldOfView / 2)) * 1.3
    camera.CFrame = CFrame.new(cf.Position + Vector3.new(dist * 0.5, dist * 0.3, dist), cf.Position)
    
    return vp
end

local function destroyViewportCham(m)
    local highlight = ESP.cache.chams[m]
    if highlight then
        pcall(function() highlight:Destroy() end)
        ESP.cache.chams[m] = nil
    end
    activeChams[m] = nil
end

local function createViewportCham(m)
    if ESP.cache.chams[m] then return end
    
    local highlight = Instance.new("Highlight")
    highlight.Name = m.Name .. "_Chams"
    highlight.Adornee = m
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.FillColor = ESP.settings.chamsColor
    highlight.FillTransparency = ESP.settings.chamsTransparency
    highlight.OutlineColor = ESP.settings.chamsColor
    highlight.OutlineTransparency = 1 
    highlight.Parent = gui
    
    ESP.cache.chams[m] = highlight
end

local function updateChams(m, enabled)
    local highlight = ESP.cache.chams[m]
    
    if not ESP.settings.chamsEnabled or not enabled then 
        if highlight then
            highlight.Enabled = false
        end
        activeChams[m] = nil
        return 
    end
    
    if not highlight then
        createViewportCham(m)
        highlight = ESP.cache.chams[m]
    end
    
    if highlight then
        highlight.Enabled = true
        highlight.FillColor = ESP.settings.chamsColor
        highlight.FillTransparency = ESP.settings.chamsTransparency
        highlight.OutlineTransparency = 1 
        activeChams[m] = true
    end
end

local function isWeaponPart(part)
    if part:FindFirstAncestor("HandModel") then
        return true
    end
    return false
end

local function applyViewmodelChams(part, isWeapon)
    if not part:IsA("BasePart") then return end
    
    if not OriginalVMProperties[part] then
        local partNameLower = part.Name:lower()
        local isInvisible = (part.Transparency >= 0.9) or 
                            (partNameLower:find("muzzle")) or 
                            (partNameLower:find("aim")) or 
                            (partNameLower:find("pointer")) or
                            (partNameLower:find("laser")) or
                            (partNameLower:find("helper")) or
                            (partNameLower:find("joint")) or
                            (partNameLower == "arrow" and not part:IsA("MeshPart"))

        OriginalVMProperties[part] = {
            Color = part.Color,
            Material = part.Material,
            Transparency = part.Transparency,
            TextureID = part:IsA("MeshPart") and part.TextureID or nil,
            IsTechnical = isInvisible
        }
    end

    local backup = OriginalVMProperties[part]
    if backup.IsTechnical then
        part.Transparency = 1
        return
    end

    local enabled = false
    local color = Color3.fromRGB(255, 255, 255)
    local materialStr = "ForceField"
    local trans = 0.5

    if isWeapon then
        enabled = ESP.settings.weaponChamsEnabled
        color = ESP.settings.weaponChamsColor
        materialStr = ESP.settings.weaponChamsMaterial
        trans = ESP.settings.weaponChamsTransparency
    else
        enabled = ESP.settings.handChamsEnabled
        color = ESP.settings.handChamsColor
        materialStr = ESP.settings.handChamsMaterial
        trans = ESP.settings.handChamsTransparency
    end

    if not enabled then
        part.Color = backup.Color
        part.Material = backup.Material
        part.Transparency = backup.Transparency
        if part:IsA("MeshPart") and backup.TextureID then
            part.TextureID = backup.TextureID
        end
        return
    end

    part.Color = color
    part.Material = Enum.Material[materialStr] or Enum.Material.ForceField
    part.Transparency = trans
    if part:IsA("MeshPart") then
        part.TextureID = "" 
    end
end

local function updateAllViewmodelChams()
    local fpsArms = getSafePath(workspace, "Const/Ignore/FPSArms") or getSafePath(workspace, "Ignore/FPSArms")
    if not fpsArms then return end

    for _, descendant in ipairs(fpsArms:GetDescendants()) do
        if descendant:IsA("BasePart") then
            local isWeapon = isWeaponPart(descendant)
            pcall(applyViewmodelChams, descendant, isWeapon)
        end
    end
end

task.spawn(function()
    while shared.SolyankaSessionToken == CurrentSessionToken do
        pcall(updateAllViewmodelChams)
        task.wait(0.1)
    end
end)

local function ESP_IsTeam(m) 
    if not m then return false end 
    local h = m:FindFirstChild("Head") 
    return h and h:FindFirstChild("Dot") and h.Dot.Enabled == true or false 
end

local function ESP_IsSleeper(m)
    if not m then return false end
    local c = ESP.cache.sleep[m] 
    if c and tick() - c.time < 1 then return c.value end
    local lt, v = m:FindFirstChild("LowerTorso"), false
    if lt then 
        local rr = lt:FindFirstChild("RootRig") 
        if rr then 
            local ok, a = pcall(function() return rr.CurrentAngle end) 
            v = ok and type(a) == "number" and a ~= 0 or false 
        end 
    end
    ESP.cache.sleep[m] = {value = v, time = tick()} 
    return v
end

local function ESP_IsPlayer(m) 
    local c = ESP.cache.player[m] 
    if c and tick() - c.time < 2 then return c.value end 
    local t = m:FindFirstChild("Torso") 
    local v = t and t:FindFirstChild("LeftBooster") and true or false 
    ESP.cache.player[m] = {value = v, time = tick()} 
    return v 
end

local function ESP_IsAI(m) 
    local t = m:FindFirstChild("Torso") or m:FindFirstChild("HumanoidRootPart") 
    return t and t.CollisionGroup == "NPC" or false 
end

local function shouldSkip(m) 
    if not m or not m.Parent then return true end 
    local s = ESP.settings
    if s.sleepCheck and ESP_IsSleeper(m) then return true end 
    if s.teamCheck and ESP_IsTeam(m) then return true end 
    if s.aiCheck and ESP_IsAI(m) then return true end 
    return false 
end

