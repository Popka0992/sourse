local function checkAndAddObject(obj)
    if not obj:IsA("Model") then return end
    task.wait(0.1)
    if not obj.Parent then return end
    
    if obj:FindFirstChild("HumanoidRootPart") then
        createEntry(obj)
    else
        local oreType, orePart = getOreTypeAndPart(obj)
        if oreType and orePart then
            createOreEntry(obj, orePart)
            return
        end
        
        local lootType, lootPart = getLootTypeAndPart(obj)
        if lootType and lootPart then
            createLootEntry(obj, lootPart)
        end
    end
end

local function parseMultiDropdown(Value, keysMap)
    for _, settingKey in pairs(keysMap) do
        ESP.settings[settingKey] = false
    end
    if type(Value) == "table" then
        for k, v in pairs(Value) do
            if type(k) == "string" then
                local settingKey = keysMap[k]
                if settingKey then ESP.settings[settingKey] = v end
            elseif type(v) == "string" then
                local settingKey = keysMap[v]
                if settingKey then ESP.settings[settingKey] = true end
            end
        end
    end
end

