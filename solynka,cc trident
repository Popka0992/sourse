local OriginalSky = nil
local CustomSky = nil

local function BackupOriginalSky()
    if not OriginalSky then
        local currentSky = Lighting:FindFirstChildOfClass("Sky")
        if currentSky then
            OriginalSky = currentSky:Clone()
            OriginalSky.Name = "OriginalSky_Backup"
        end
    end
end

local function RestoreOriginalSky()
    if CustomSky then
        pcall(function() CustomSky:Destroy() end)
        CustomSky = nil
    end
    
    for _, child in ipairs(Lighting:GetChildren()) do
        if child:IsA("Sky") and child.Name == "Solyanka_CustomSky" then
            pcall(function() child:Destroy() end)
        end
    end

    if OriginalSky then
        local existingSky = Lighting:FindFirstChildOfClass("Sky")
        if existingSky then
            pcall(function() existingSky:Destroy() end)
        end
        local restored = OriginalSky:Clone()
        restored.Name = "Sky"
        restored.Parent = Lighting
    end
end

local function ApplySkybox(name)
    BackupOriginalSky()
    
    local preset = SkyboxPresets[name]
    if not preset then return end

    local existingSky = Lighting:FindFirstChildOfClass("Sky")
    if existingSky then
        pcall(function() existingSky:Destroy() end)
    end

    CustomSky = Instance.new("Sky")
    CustomSky.Name = "Solyanka_CustomSky"
    
    for prop, val in pairs(preset) do
        pcall(function()
            CustomSky[prop] = val
        end)
    end
    
    CustomSky.Parent = Lighting
end

local function UpdateSkyboxState()
    if SkyboxSettings.Enabled then
        ApplySkybox(SkyboxSettings.Selected)
    else
        RestoreOriginalSky()
    end
end

local function GetStealthCorrection()
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    
    local effect = cam:FindFirstChild("Solyanka_StealthCorrection")
    if not effect then
        effect = Instance.new("ColorCorrectionEffect")
        effect.Name = "Solyanka_StealthCorrection"
        effect.Parent = cam
    end
