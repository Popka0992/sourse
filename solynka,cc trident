                        clonedVisual.Parent = cell
                        
                        cell.Parent = d.combinedFrame
                        table.insert(d.activeArmorVisuals, cell)
                    end
                end
            end
        else
            if #d.activeArmorVisuals > 0 then
                for _, av in ipairs(d.activeArmorVisuals) do av:Destroy() end
                d.activeArmorVisuals = {}
                d.lastArmorList = {}
                d.armorNeedsRebuild = false
            end
        end

        local total3DItems = (d.activeVisual and 1 or 0) + #d.activeArmorVisuals
